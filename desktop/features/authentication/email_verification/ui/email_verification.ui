   <string notr="true">
QWidget#EmailVerificationView { background-color:#FFFFFF; font-family:'Inter'; }
QFrame#topBar { background-color:#FFFFFF; border-bottom:1px solid #E5E7EB; }
QFrame#contentArea { background-color:#F4F7FE; }
QFrame#authCard { background-color:#FFFFFF; border-radius:20px; border:1px solid #EEF1F6; }
QFrame#emailChip { background-color:#F1F5FF; border-radius:12px; border:1px solid #DCE6FF; }
QLabel#lblAppName { font-size:16px; font-weight:600; color:#111827; }
QLabel#lblBrandName { font-size:28px; font-weight:700; }
QLabel#lblTagline { font-size:13px; font-weight:600; }
QLabel#lblSectionTitle { font-size:20px; font-weight:700; color:#111827; }
QLabel#lblSectionDesc { font-size:13px; color:#64748B; }
QLabel#lblIconEnvelope { font-size:40px; }
QLabel#lblCardTitle { font-size:22px; font-weight:700; color:#0F172A; }
QLabel#lblCardSubtitle { font-size:13px; color:#64748B; }
QLabel#lblEmailTarget { font-size:13px; font-weight:700; color:#2563EB; }
QLabel#lblEmailChipText { font-size:13px; font-weight:600; color:#1E293B; }
QPushButton#btnChangeEmail { background:transparent; border:none; color:#2563EB; font-size:12px; font-weight:600; text-align:left; }
QLineEdit#inputOtp1, QLineEdit#inputOtp2, QLineEdit#inputOtp3, QLineEdit#inputOtp4, QLineEdit#inputOtp5, QLineEdit#inputOtp6 { min-width:44px; max-width:44px; min-height:56px; max-height:56px; border:1px solid #E2E8F0; border-radius:10px; font-size:22px; font-weight:700; qproperty-alignment: AlignCenter; background:#FFFFFF; }
QLineEdit#inputOtp1:focus, QLineEdit#inputOtp2:focus, QLineEdit#inputOtp3:focus, QLineEdit#inputOtp4:focus, QLineEdit#inputOtp5:focus, QLineEdit#inputOtp6:focus { border:2px solid #2563EB; }
QLabel#lblResendHint { font-size:12px; color:#64748B; }
QPushButton#btnResendTimer { background:transparent; border:none; color:#2563EB; font-size:12px; font-weight:700; }
QPushButton#btnVerify { background-color:#2563EB; color:#FFFFFF; font-size:15px; font-weight:600; border-radius:10px; min-height:48px; }
QPushButton#btnVerify:hover { background-color:#1D4ED8; }
QPushButton#btnResendCode { background-color:#FFFFFF; color:#2563EB; font-size:14px; font-weight:600; border:1px solid #2563EB; border-radius:10px; min-height:48px; }
QPushButton#btnBackToLogin, QPushButton#btnGoToRegister, QPushButton#btnHelp { background:transparent; border:none; color:#2563EB; font-size:13px; font-weight:600; }
QPushButton#btnMinimize, QPushButton#btnMaximize, QPushButton#btnClose { background:transparent; border:none; font-size:14px; color:#374151; }
QPushButton#btnClose:hover { background-color:#FEE2E2; border-radius:6px; }
QPushButton#btnThemeLight, QPushButton#btnThemeDark { border:none; border-radius:14px; padding:4px 10px; background:transparent; }
QPushButton#btnThemeLight:checked, QPushButton#btnThemeDark:checked { background-color:#DBEAFE; }
QFrame#footerBar { background-color:#FFFFFF; border-top:1px solid #E5E7EB; }
QLabel#lblCopyright, QLabel#lblNoAccount { font-size:12px; color:#64748B; }
