  <property name="styleSheet">
   <string notr="true">
QWidget#ForgotPasswordView { background-color:#FFFFFF; font-family:'Inter'; }
QFrame#topBar { background-color:#FFFFFF; border-bottom:1px solid #E5E7EB; }
QFrame#contentArea { background-color:#F4F7FE; }
QFrame#authCard { background-color:#FFFFFF; border-radius:20px; border:1px solid #EEF1F6; }
QFrame#securityNotice { background-color:#F1F5FF; border-radius:12px; border:1px solid #DCE6FF; }
QLabel#lblAppName { font-size:16px; font-weight:600; color:#111827; }
QLabel#lblBrandName { font-size:28px; font-weight:700; }
QLabel#lblTagline { font-size:13px; font-weight:600; }
QLabel#lblSectionTitle { font-size:20px; font-weight:700; color:#111827; }
QLabel#lblSectionDesc { font-size:13px; color:#64748B; }
QLabel#lblIconEnvelope { font-size:40px; }
QLabel#lblCardTitle { font-size:22px; font-weight:700; color:#0F172A; }
QLabel#lblCardSubtitle { font-size:13px; color:#64748B; }
QLabel#lblFieldEmail { font-size:13px; font-weight:600; color:#374151; }
QLabel#lblNoticeTitle { font-size:13px; font-weight:700; color:#1E3A8A; }
QLabel#lblNoticeDesc { font-size:12px; color:#3B5CA8; }
QLineEdit { min-height:44px; border:1px solid #E2E8F0; border-radius:10px; padding:0 12px; font-size:13px; }
QLineEdit:focus { border:1px solid #2563EB; }
QPushButton#btnSendReset { background-color:#2563EB; color:#FFFFFF; font-size:15px; font-weight:600; border-radius:10px; min-height:48px; }
QPushButton#btnSendReset:hover { background-color:#1D4ED8; }
QPushButton#btnNeedHelp { background-color:#FFFFFF; color:#2563EB; font-size:14px; font-weight:600; border:1px solid #2563EB; border-radius:10px; min-height:48px; }
QPushButton#btnBackToLogin, QPushButton#btnGoToLogin, QPushButton#btnHelp { background:transparent; border:none; color:#2563EB; font-size:13px; font-weight:600; }
QPushButton#btnMinimize, QPushButton#btnMaximize, QPushButton#btnClose { background:transparent; border:none; font-size:14px; color:#374151; }
QPushButton#btnClose:hover { background-color:#FEE2E2; border-radius:6px; }
QPushButton[role="themeToggleBtn"] { border:none; border-radius:14px; padding:4px 10px; background:transparent; }
QPushButton[role="themeToggleBtn"]:checked { background-color:#DBEAFE; }
QFrame#footerBar { background-color:#FFFFFF; border-top:1px solid #E5E7EB; }
QLabel#lblCopyright, QLabel#lblRememberPassword { font-size:12px; color:#64748B; }
   </string>
