  <property name="styleSheet">
   <string notr="true">
QWidget#RegisterView { background-color:#FFFFFF; font-family:'Inter'; }
QFrame#topBar { background-color:#FFFFFF; border-bottom:1px solid #E5E7EB; }
QFrame#contentArea { background-color:#F4F7FE; }
QFrame#authCard { background-color:#FFFFFF; border-radius:20px; border:1px solid #EEF1F6; }
QLabel#lblAppName { font-size:16px; font-weight:600; color:#111827; }
QLabel#lblBrandName { font-size:30px; font-weight:700; }
QLabel#lblTagline { font-size:13px; font-weight:600; }
QLabel#lblSectionTitle { font-size:20px; font-weight:700; color:#111827; }
QLabel#lblSectionDesc { font-size:13px; color:#64748B; }
QLabel#lblFullNameLabel, QLabel#lblRoleLabel, QLabel#lblEmailLabel, QLabel#lblPhoneLabel, QLabel#lblPasswordLabel, QLabel#lblConfirmPasswordLabel, QLabel#lblInstitutionLabel { font-size:13px; font-weight:600; color:#374151; }
QLabel#lblTitle { font-size:24px; font-weight:700; color:#0F172A; }
QLabel#lblRoleBadge { font-size:20px; font-weight:700; color:#2563EB; }
QLabel#lblSubtitle { font-size:13px; color:#64748B; }
QLineEdit, QComboBox { min-height:44px; border:1px solid #E2E8F0; border-radius:10px; padding:0 12px; font-size:13px; color:#1E293B; background:#FFFFFF; }
QLineEdit:focus, QComboBox:focus { border:1px solid #2563EB; }
QPushButton#btnRegister { background-color:#2563EB; color:#FFFFFF; font-size:15px; font-weight:600; border-radius:10px; min-height:48px; }
QPushButton#btnRegister:hover { background-color:#1D4ED8; }
QPushButton#btnRegisterGoogle { background-color:#FFFFFF; color:#1E293B; font-size:14px; font-weight:600; border:1px solid #E2E8F0; border-radius:10px; min-height:48px; }
QPushButton#btnBackToLogin, QPushButton#btnTermsLink, QPushButton#btnPrivacyLink, QPushButton#btnGoToLogin, QPushButton#btnHelp { background:transparent; border:none; color:#2563EB; font-size:13px; font-weight:600; text-align:left; }
QPushButton#btnMinimize, QPushButton#btnMaximize, QPushButton#btnClose { background:transparent; border:none; font-size:14px; color:#374151; }
QPushButton#btnClose:hover { background-color:#FEE2E2; border-radius:6px; }
QPushButton#btnThemeLight, QPushButton#btnThemeDark { border:none; border-radius:14px; padding:4px 10px; background:transparent; }
QPushButton#btnThemeLight:checked, QPushButton#btnThemeDark:checked { background-color:#DBEAFE; }
QPushButton#btnTogglePassword, QPushButton#btnToggleConfirmPassword { background:transparent; border:none; }
QFrame#footerBar { background-color:#FFFFFF; border-top:1px solid #E5E7EB; }
QLabel#lblCopyright, QLabel#lblHaveAccount, QLabel#lblAnd { font-size:12px; color:#64748B; }
   </string>
