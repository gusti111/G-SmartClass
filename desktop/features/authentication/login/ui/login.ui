 <class>LoginView</class>
 <widget class="QWidget" name="LoginView">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1456</width><height>1080</height></rect>
  </property>
  <property name="windowTitle"><string>G-SmartClass - Login</string></property>
  <property name="minimumSize"><size><width>1100</width><height>780</height></size></property>
  <property name="styleSheet">
   <string notr="true">
QWidget#LoginView { background-color:#FFFFFF; font-family:'Poppins'; }
QFrame#topBar { background-color:#FFFFFF; border-bottom:1px solid #E5E7EB; }
QFrame#leftPanel { background-color:#EAF1FE; }
QFrame#authCard { background-color:#FFFFFF; border-radius:20px; border:1px solid #EEF1F6; }
QFrame#featureItemMaterial QLabel#iconFeatureMaterial, QFrame#featureItemCollab QLabel#iconFeatureCollab, QFrame#featureItemProgress QLabel#iconFeatureProgress { border-radius:10px; }
QLabel#lblAppName { font-size:16px; font-weight:600; color:#111827; }
QLabel#lblBrandName { font-size:26px; font-weight:700; }
QLabel#lblTagline { font-size:13px; font-weight:600; }
QLabel#lblHeadline { font-size:30px; font-weight:700; color:#0F172A; }
QLabel#lblHeadlineDesc { font-size:14px; color:#475569; }
QLabel#lblCardTitle { font-size:24px; font-weight:700; color:#0F172A; }
QLabel#lblCardSubtitle { font-size:13px; color:#64748B; }
QPushButton[role="loginTab"] { background:transparent; border:none; border-bottom:2px solid transparent; font-size:14px; font-weight:600; color:#64748B; padding-bottom:10px; }
QPushButton[role="loginTab"]:checked { color:#2563EB; border-bottom:2px solid #2563EB; }
QLabel[role="fieldLabel"] { font-size:13px; font-weight:600; color:#374151; }
QLineEdit { min-height:46px; border:1px solid #E2E8F0; border-radius:10px; padding:0 12px; font-size:14px; color:#0F172A; background:#FFFFFF; }
QLineEdit:focus { border:1px solid #2563EB; }
QPushButton#btnTogglePassword { background:transparent; border:none; }
QPushButton#btnForgotPassword { background:transparent; border:none; color:#2563EB; font-size:13px; font-weight:600; }
QPushButton#btnLogin { background-color:#2563EB; color:#FFFFFF; font-size:15px; font-weight:600; border-radius:12px; min-height:50px; }
QPushButton#btnLogin:hover { background-color:#1D4ED8; }
QPushButton#btnLoginGoogle, QPushButton#btnLoginMicrosoft, QPushButton#btnLoginApple { background-color:#FFFFFF; color:#0F172A; font-size:14px; font-weight:600; border:1px solid #E2E8F0; border-radius:10px; min-height:48px; }
QPushButton#btnLoginGoogle:hover, QPushButton#btnLoginMicrosoft:hover, QPushButton#btnLoginApple:hover { background-color:#F8FAFC; }
QPushButton#btnGoToRegister, QPushButton#btnHelp { background:transparent; border:none; color:#2563EB; font-size:13px; font-weight:600; }
QPushButton#btnMinimize, QPushButton#btnMaximize, QPushButton#btnClose { background:transparent; border:none; font-size:14px; color:#374151; }
QPushButton#btnClose:hover { background-color:#FEE2E2; border-radius:6px; }
QPushButton#btnThemeDark, QPushButton#btnThemeLight { background:transparent; border:none; font-size:16px; }
QLabel#lblSecureBadge, QLabel#lblVersion { font-size:12px; color:#2563EB; font-weight:600; }
QLabel#lblNoAccount { font-size:13px; color:#64748B; }
   </string>
